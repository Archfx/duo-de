 delete mode 100644 aidl_api/av-audio-types-aidl/1/android/media/audio/IHalAdapterVendorExtension.aidl
 delete mode 100644 aidl_api/av-audio-types-aidl/current/android/media/audio/IHalAdapterVendorExtension.aidl

