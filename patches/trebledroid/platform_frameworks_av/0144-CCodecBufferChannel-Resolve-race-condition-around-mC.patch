                                     C2_DONT_BLOCK,
                                     &params);
@@ -1850,7 +1850,7 @@ status_t CCodecBufferChannel::start(
             // if unsuccessful.
             if (outputSurface) {
                 params.clear();
-                err = mComponent->query({ },
