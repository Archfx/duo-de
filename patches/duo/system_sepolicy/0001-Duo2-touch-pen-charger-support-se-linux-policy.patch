From fa0a3eff07c9c6c22a6ed4da979e4f71f4a87a7d Mon Sep 17 00:00:00 2001
From: Archfx <cybx@live.com>
Date: Wed, 2 Apr 2025 10:27:06 -0400
Subject: [PATCH] Duo2 touch pen charger support se-linux policy

Change-Id: I7bf7c92739725b8ee8422e21999e4212c83c14e0
---
 private/file.te        | 4 ++++
 private/genfs_contexts | 3 +++
 private/system_app.te  | 3 +++
 3 files changed, 10 insertions(+)

diff --git a/private/file.te b/private/file.te
index 189fb4789..8f8df3537 100644
--- a/private/file.te
+++ b/private/file.te
@@ -222,6 +222,10 @@ type storage_area_content_file, file_type, data_file_type, core_data_file_type,
 # /data/misc_ce/userId/storage_area_keys
 type storage_area_key_file, file_type, data_file_type, core_data_file_type;
 
+# definition for duo2 touch pen charger
+type ms_pen_charger_file, file_type, data_file_type, core_data_file_type;
+
+
 # /metadata/tradeinmode files
 type tradeinmode_metadata_file, file_type;
 
diff --git a/private/genfs_contexts b/private/genfs_contexts
index 3ff1012b7..54e7be8dc 100644
--- a/private/genfs_contexts
+++ b/private/genfs_contexts
@@ -339,3 +339,7 @@ genfscon bpf /netd_shared u:object_r:fs_bpf_netd_shared:s0
 genfscon bpf /tethering u:object_r:fs_bpf_tethering:s0
 genfscon bpf /vendor u:object_r:fs_bpf_vendor:s0
 genfscon bpf /uprobestats u:object_r:fs_bpf_uprobestats:s0
+
+# duo2 touch pen charger allow read and write
+genfscon sysfs /devices/platform/soc/soc:surface_util/ms_pen_charger/ms_pen_charger u:object_r:ms_pen_charger_file:s0
+
diff --git a/private/system_app.te b/private/system_app.te
index 93be46f0a..04ad1604a 100644
--- a/private/system_app.te
+++ b/private/system_app.te
@@ -203,3 +203,7 @@ allow system_app vendor_boot_ota_file:file { r_file_perms };
 # allow system_app to read system_dlkm_file for /system_dlkm/etc/NOTICE.xml.gz
 allow system_app system_dlkm_file:dir search;
 allow system_app system_dlkm_file:file { getattr open read };
+
+# duo2 touch pen charger allow read and write
+allow system_app ms_pen_charger_file:file { r_file_perms w_file_perms };
+
-- 
2.34.1

