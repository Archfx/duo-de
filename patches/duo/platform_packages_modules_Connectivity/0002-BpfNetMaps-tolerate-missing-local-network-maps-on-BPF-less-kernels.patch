From 47ef533d9dcecbb8a251788b77fb741271f324bd Mon Sep 17 00:00:00 2001
From: Michael Kostersitz <mkostersitz@mac.com>
Date: Tue, 27 Oct 2026 10:50:07 +0000
Subject: [PATCH] BpfNetMaps: tolerate missing local network maps on BPF-less
 kernels

On a kernel without BPF (Duo 1 and Duo 2) the BPF loader cannot create the local_net_blocked_uid / local_net_access maps,
so sLocalNetBlockedUidMap stays null. PermissionMonitor.onPackageRemoved -> removeUidFromLocalNetBlockMap then threw a
NullPointerException in ConnectivityServiceThread, which is a system process crash on every package replace/removal
(Play Store installs and updates). Guard the three local_net_blocked_uid methods and getLocalNetAccess like the other
map users already are.

Log seen on Duo 1 (Archfx/duo-de#280, #273): NullPointerException at BpfNetMaps.removeUidFromLocalNetBlockMap(BpfNetMaps.java:1074)
from PermissionMonitor.onPackageRemoved(PermissionMonitor.java:918).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Change-Id: Id54ef21198432fe2b97c029990631d15a4f322c8
---
 service/src/com/android/server/BpfNetMaps.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/service/src/com/android/server/BpfNetMaps.java b/service/src/com/android/server/BpfNetMaps.java
index 10d5312ca3..2ba145ba54 100644
--- a/service/src/com/android/server/BpfNetMaps.java
+++ b/service/src/com/android/server/BpfNetMaps.java
@@ -1022,6 +1022,7 @@ public class BpfNetMaps {
         }
         final LocalNetAccessKey localNetAccessKey = new LocalNetAccessKey(lpmBitlen, ifIndex,
                 address, protocol, remotePort);
+        if (sLocalNetAccessMap == null) return true;   // BPF-less kernel: default is allowed
         try {
             final Bool value = sLocalNetAccessMap.getValue(localNetAccessKey);
             return value == null ? true : value.val;
@@ -1039,6 +1040,7 @@ public class BpfNetMaps {
     @RequiresApi(Build.VERSION_CODES.CUR_DEVELOPMENT)
     public void addUidToLocalNetBlockMap(final int uid) {
         throwIfPre25Q2("addUidToLocalNetBlockMap is not available on pre-B devices");
+        if (sLocalNetBlockedUidMap == null) return;   // BPF-less kernel: the map does not exist
         try {
             sLocalNetBlockedUidMap.updateEntry(new U32(uid), new Bool(true));
         } catch (ErrnoException e) {
@@ -1053,6 +1055,7 @@ public class BpfNetMaps {
     @RequiresApi(Build.VERSION_CODES.CUR_DEVELOPMENT)
     public boolean isUidBlockedFromUsingLocalNetwork(final int uid) {
         throwIfPre25Q2("isUidBlockedFromUsingLocalNetwork is not available on pre-B devices");
+        if (sLocalNetBlockedUidMap == null) return false;   // BPF-less kernel: nothing is blocked
         try {
             final Bool value = sLocalNetBlockedUidMap.getValue(new U32(uid));
             return value == null ? false : value.val;
@@ -1070,6 +1073,7 @@ public class BpfNetMaps {
     @RequiresApi(Build.VERSION_CODES.CUR_DEVELOPMENT)
     public void removeUidFromLocalNetBlockMap(final int uid) {
         throwIfPre25Q2("removeUidFromLocalNetBlockMap is not available on pre-B devices");
+        if (sLocalNetBlockedUidMap == null) return;   // BPF-less kernel: the map does not exist (PACKAGE_REMOVED crashed here)
         try {
             sLocalNetBlockedUidMap.deleteEntry(new U32(uid));
         } catch (ErrnoException e) {
-- 
