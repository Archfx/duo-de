From 0eec9a3f409f73fc96341bd154d3e7b3bb8c3756 Mon Sep 17 00:00:00 2001
From: Mike Kostersitz <mkostersitz@mac.com>
Date: Fri, 16 Oct 2026 17:07:50 +0000
Subject: [PATCH] GApps: use Launcher3 as config_recentsComponentName (Pixel
 launcher is removed)

On GApps builds Launcher3 creates an app prediction session, which the system only
allows for callers holding PACKAGE_USAGE_STATS; without it Launcher3 crash-loops
("Permission Denial: createPredictionSession"). Same approach as Archfx a16-dev
5b94514.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 common/rro_overlays/GmsConfigOverlay/res/values/config.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/rro_overlays/GmsConfigOverlay/res/values/config.xml b/common/rro_overlays/GmsConfigOverlay/res/values/config.xml
index 6a42416..26b011e 100644
--- a/common/rro_overlays/GmsConfigOverlay/res/values/config.xml
+++ b/common/rro_overlays/GmsConfigOverlay/res/values/config.xml
@@ -378,7 +378,7 @@
           to fetching and presenting recent tasks. The default configuration uses Launcehr3QuickStep as default launcher and points to
           the corresponding recents component. When using a different default launcher, change this appropriately or use the default
           systemui implementation: com.android.systemui/.recents.RecentsActivity -->
-    <string name="config_recentsComponentName" translatable="false">com.google.android.apps.nexuslauncher/com.android.quickstep.RecentsActivity</string>
+    <string name="config_recentsComponentName" translatable="false">com.android.launcher3/com.android.quickstep.RecentsActivity</string>
 
     <!-- Define device configs on boot -->
     <string-array name="global_device_configs_override">
-- 
2.43.0

