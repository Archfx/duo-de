From d79f4433506dfa0d3a12dd9250894a5cc33fd412 Mon Sep 17 00:00:00 2001
From: ethan <ethangoh98@gmail.com>
Date: Thu, 19 October 2026 01:12:32 +1100
Subject: [PATCH] Set wallpaper default from google to AOSP.

diff --git a/common/common-vendor.mk b/common/common-vendor.mk
index 5f462e5..f12a534 100644
--- a/common/common-vendor.mk
+++ b/common/common-vendor.mk
@@ -50,8 +50,7 @@ PRODUCT_PACKAGES += \
     Velvet \
     WellbeingPrebuilt \
     GoogleFeedback \
-    GoogleServicesFramework \
-    WallpaperPickerGoogleRelease
+    GoogleServicesFramework
 
 PRODUCT_PACKAGES += \
     privapp_permissions_google \
diff --git a/common/proprietary/system_ext/priv-app/Android.bp b/common/proprietary/system_ext/priv-app/Android.bp
index 443d3e0..561fc98 100644
--- a/common/proprietary/system_ext/priv-app/Android.bp
+++ b/common/proprietary/system_ext/priv-app/Android.bp
@@ -22,18 +22,4 @@ android_app_import {
     },
     privileged: true,
     system_ext_specific: true,
-}
-
-android_app_import {
-    name: "WallpaperPickerGoogleRelease",
-    overrides: ["WallpaperPicker", "WallpaperPicker2", "WallpaperCropper"],
-    owner: "google",
-    apk: "WallpaperPickerGoogleRelease/WallpaperPickerGoogleRelease.apk",
-    presigned: true,
-    preprocessed: true,
-    dex_preopt: {
-        enabled: false,
-    },
-    privileged: true,
-    system_ext_specific: true,
-}
+}
\ No newline at end of file
diff --git a/common/rro_overlays/GmsConfigOverlay/res/values/config.xml b/common/rro_overlays/GmsConfigOverlay/res/values/config.xml
index 26b011e..1171d53 100644
--- a/common/rro_overlays/GmsConfigOverlay/res/values/config.xml
+++ b/common/rro_overlays/GmsConfigOverlay/res/values/config.xml
@@ -206,11 +206,6 @@
      -->
     <string name="config_defaultNetworkRecommendationProviderPackage" translatable="false">com.google.android.gms</string>
 
-    <!-- Wallpaper cropper package. Used as the default cropper if the active launcher doesn't
-         handle wallpaper cropping.
-    -->
-    <string name="config_wallpaperCropperPackage" translatable="false">com.google.android.apps.wallpaper</string>
-
     <!-- A list of potential packages, in priority order, that may contain an
          ephemeral resolver. Each package will be be queried for a component
          that has been granted the PACKAGE_EPHEMERAL_AGENT permission.
diff --git a/common/rro_overlays/GmsSettingsOverlay/res/values/config.xml b/common/rro_overlays/GmsSettingsOverlay/res/values/config.xml
index 2469112..0f7215c 100644
--- a/common/rro_overlays/GmsSettingsOverlay/res/values/config.xml
+++ b/common/rro_overlays/GmsSettingsOverlay/res/values/config.xml
@@ -15,18 +15,6 @@
      limitations under the License.
 -->
 <resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
-     <!-- Package name and fully-qualified class name for the wallpaper picker activity. -->
-    <string name="config_wallpaper_picker_package" translatable="false">com.google.android.apps.wallpaper</string>
-
-    <!-- Fully-qualified class name for the wallpaper picker activity. -->
-    <string name="config_wallpaper_picker_class" translatable="false">com.android.customization.picker.CustomizationPickerActivity</string>
-
-    <!-- Fully-qualified class name for the styles & wallpaper picker activity. -->
-    <string name="config_styles_and_wallpaper_picker_class" translatable="false">com.android.customization.picker.CustomizationPickerActivity</string>
-
-    <!-- Action name for the styles & wallpaper picker activity. -->
-    <string name="config_styles_and_wallpaper_picker_action" translatable="false">android.intent.action.SET_WALLPAPER</string>
-
     <!-- BT Slice EXTRA_INTENT. To support Settings 2 panel, BT slice can't use PendingIntent.send(). Therefore, here defines the Slice EXTRA_INTENT. -->
     <string name="config_bt_slice_extra_intent" translatable="false">com.google.android.gms.nearby.discovery.EXTRA_INTENT</string>
 
