diff --git a/surface-sdk/boot/java/com/microsoft/device/display/HingeMath.java b/surface-sdk/boot/java/com/microsoft/device/display/HingeMath.java
new file mode 100644
index 0000000..37c1305
--- /dev/null
+++ b/surface-sdk/boot/java/com/microsoft/device/display/HingeMath.java
@@ -0,0 +1,52 @@
+package com.microsoft.device.display;
+
+/**
+ * Pure integer geometry for the Surface Duo hinge, kept free of android.* classes so it can be unit tested on the host.
+ * Rectangles are {left, top, right, bottom}. "Natural" is rotation 0: the wide orientation, two portrait panels side by side.
+ */
+final class HingeMath {
+    private HingeMath() { }
+
+    /** Hinge rectangle in rotation-0 physical coordinates: {panel, 0, panel + hinge, height}. */
+    static int[] naturalHinge(int panel, int hinge, int height) {
+        return new int[] {panel, 0, panel + hinge, height};
+    }
+
+    /**
+     * Maps a rotation-0 physical rectangle to the logical coordinates of a display rotated by the given Surface.ROTATION_*
+     * value. naturalWidth/naturalHeight are the physical size at rotation 0. Rotation 1 is 90 degrees, 3 is 270.
+     */
+    static int[] rotate(int[] r, int naturalWidth, int naturalHeight, int rotation) {
+        switch (rotation) {
+            case 0: return new int[] {r[0], r[1], r[2], r[3]};
+            case 1: return new int[] {r[1], naturalWidth - r[2], r[3], naturalWidth - r[0]};
+            case 2: return new int[] {naturalWidth - r[2], naturalHeight - r[3], naturalWidth - r[0], naturalHeight - r[1]};
+            case 3: return new int[] {naturalHeight - r[3], r[0], naturalHeight - r[1], r[2]};
+            default: throw new IllegalArgumentException("Invalid rotation: " + rotation);
+        }
+    }
+
+    /** True when the two rectangles overlap; rectangles that only touch along an edge do not intersect. */
+    static boolean intersects(int[] a, int[] b) {
+        return a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3];
+    }
+
+    /** True when the display's natural width is exactly two panels (the hinge gap is disabled, no pixels between the panels). */
+    static boolean isGapless(int naturalWidth, int panel) {
+        return naturalWidth == 2 * panel;
+    }
+
+    /** Rotation-0 hinge for a gapless display: a 2 px virtual seam centred on the panel boundary. */
+    static int[] gaplessSeam(int panel, int height) {
+        return new int[] {panel - 1, 0, panel + 1, height};
+    }
+
+    /**
+     * Gapless display: the seam is a 2 px strip straddling the panel boundary, so a rectangle intersection would also report it for a single
+     * panel (its edge touches the seam by 1 px). Instead the seam counts as visible only when the app-visible area is wider than one panel
+     * along the display's natural width axis (width at rotation 0/2, height at rotation 1/3).
+     */
+    static boolean gaplessSpanned(int areaWidth, int areaHeight, int rotation, int panel) {
+        return ((rotation & 1) == 0 ? areaWidth : areaHeight) > panel;
+    }
+}
diff --git a/surface-sdk/boot/test/HingeMathTest.java b/surface-sdk/boot/test/HingeMathTest.java
new file mode 100644
index 0000000..94ad8f9
--- /dev/null
+++ b/surface-sdk/boot/test/HingeMathTest.java
@@ -0,0 +1,61 @@
+package com.microsoft.device.display;
+
+import java.util.Arrays;
+
+/** Host test for HingeMath (no Android classes). Run: javac -d /tmp/hm HingeMath.java test/HingeMathTest.java && java -cp /tmp/hm com.microsoft.device.display.HingeMathTest */
+public class HingeMathTest {
+    static int failures;
+
+    static void eq(String what, int[] want, int[] got) {
+        if (!Arrays.equals(want, got)) { failures++; System.out.println("FAIL " + what + ": want " + Arrays.toString(want) + " got " + Arrays.toString(got)); }
+        else System.out.println("ok   " + what);
+    }
+    static void truth(String what, boolean want, boolean got) {
+        if (want != got) { failures++; System.out.println("FAIL " + what + ": want " + want + " got " + got); } else System.out.println("ok   " + what);
+    }
+
+    public static void main(String[] a) {
+        // Duo 2: 2754x1892, panel 1344, hinge 66
+        int[] h2 = HingeMath.naturalHinge(1344, 66, 1892);
+        eq("duo2 natural", new int[] {1344, 0, 1410, 1892}, h2);
+        eq("duo2 rot0", new int[] {1344, 0, 1410, 1892}, HingeMath.rotate(h2, 2754, 1892, 0));
+        eq("duo2 rot1", new int[] {0, 1344, 1892, 1410}, HingeMath.rotate(h2, 2754, 1892, 1));
+        eq("duo2 rot2", new int[] {1344, 0, 1410, 1892}, HingeMath.rotate(h2, 2754, 1892, 2));
+        eq("duo2 rot3", new int[] {0, 1344, 1892, 1410}, HingeMath.rotate(h2, 2754, 1892, 3));
+        // Duo 1: 2784x1800, panel 1350, hinge 84
+        int[] h1 = HingeMath.naturalHinge(1350, 84, 1800);
+        eq("duo1 rot0", new int[] {1350, 0, 1434, 1800}, HingeMath.rotate(h1, 2784, 1800, 0));
+        eq("duo1 rot1", new int[] {0, 1350, 1800, 1434}, HingeMath.rotate(h1, 2784, 1800, 1));
+        eq("duo1 rot3", new int[] {0, 1350, 1800, 1434}, HingeMath.rotate(h1, 2784, 1800, 3));
+        // an off-centre hinge must rotate correctly (guards against the old hand-written table): hinge at 1000..1066 of 2754
+        int[] off = {1000, 0, 1066, 1892};
+        eq("offcentre rot1", new int[] {0, 1688, 1892, 1754}, HingeMath.rotate(off, 2754, 1892, 1));
+        eq("offcentre rot3", new int[] {0, 1000, 1892, 1066}, HingeMath.rotate(off, 2754, 1892, 3));
+        eq("offcentre rot2", new int[] {1688, 0, 1754, 1892}, HingeMath.rotate(off, 2754, 1892, 2));
+        try { HingeMath.rotate(h2, 2754, 1892, 4); failures++; System.out.println("FAIL rotation 4 should throw"); }
+        catch (IllegalArgumentException e) { System.out.println("ok   rotation 4 throws"); }
+        // visibility: app area vs hinge for the current rotation
+        truth("full spanned 2754x1892 sees hinge", true, HingeMath.intersects(HingeMath.rotate(h2, 2754, 1892, 0), new int[] {0, 0, 2754, 1892}));
+        truth("single panel 1344x1892: touching edge, no hinge", false, HingeMath.intersects(HingeMath.rotate(h2, 2754, 1892, 0), new int[] {0, 0, 1344, 1892}));
+        truth("half window 1377 wide sees hinge", true, HingeMath.intersects(HingeMath.rotate(h2, 2754, 1892, 0), new int[] {0, 0, 1377, 1892}));
+        truth("window 1300 wide: no hinge", false, HingeMath.intersects(HingeMath.rotate(h2, 2754, 1892, 0), new int[] {0, 0, 1300, 1892}));
+        truth("portrait spanned 1892x2754 at rot1 sees hinge", true, HingeMath.intersects(HingeMath.rotate(h2, 2754, 1892, 1), new int[] {0, 0, 1892, 2754}));
+        truth("portrait single panel 1892x1344 at rot1: no hinge", false, HingeMath.intersects(HingeMath.rotate(h2, 2754, 1892, 1), new int[] {0, 0, 1892, 1344}));
+        // gapless (hinge gap disabled): 2688x1892, 2 px virtual seam
+        truth("2688 is gapless for panel 1344", true, HingeMath.isGapless(2688, 1344));
+        truth("2754 is not gapless", false, HingeMath.isGapless(2754, 1344));
+        int[] seam = HingeMath.gaplessSeam(1344, 1892);
+        eq("gapless seam", new int[] {1343, 0, 1345, 1892}, seam);
+        eq("gapless seam rot1", new int[] {0, 1343, 1892, 1345}, HingeMath.rotate(seam, 2688, 1892, 1));
+        truth("gapless full area sees seam", true, HingeMath.intersects(seam, new int[] {0, 0, 2688, 1892}));
+        truth("gapless single panel: no seam", false, HingeMath.intersects(seam, new int[] {0, 0, 1343, 1892}));
+        truth("gapless spanned 2688x1892 rot0", true, HingeMath.gaplessSpanned(2688, 1892, 0, 1344));
+        truth("gapless single panel 1344x1892 rot0", false, HingeMath.gaplessSpanned(1344, 1892, 0, 1344));
+        truth("gapless spanned portrait 1892x2688 rot1", true, HingeMath.gaplessSpanned(1892, 2688, 1, 1344));
+        truth("gapless single panel portrait 1892x1344 rot1", false, HingeMath.gaplessSpanned(1892, 1344, 1, 1344));
+        truth("gapless single panel portrait 1892x1344 rot3", false, HingeMath.gaplessSpanned(1892, 1344, 3, 1344));
+        truth("gapless 180: spanned 2688x1892 rot2", true, HingeMath.gaplessSpanned(2688, 1892, 2, 1344));
+        System.out.println(failures == 0 ? "ALL PASS" : failures + " FAILURES");
+        if (failures != 0) System.exit(1);
+    }
+}
