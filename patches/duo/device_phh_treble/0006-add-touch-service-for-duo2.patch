From d79f4433506dfa0d3a12dd9250894a5cc33fd412 Mon Sep 17 00:00:00 2001
From: ethan <ethangoh98@gmail.com>
Date: Thu, 1 October 2026 3:27:32 +1100
Subject: [PATCH] Set product packages to install from vendor for duo2 touch deadzone bug

diff --git a/aosp.mk b/aosp.mk
index f3a8fae..d21dc93 100644
--- a/aosp.mk
+++ b/aosp.mk
@@ -1,4 +1,4 @@
 $(call inherit-product, vendor/ponces/config/common.mk)
 
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    ro.system.ota.json_url=https://raw.githubusercontent.com/Archfx/duo-de/main-16/config/ota.json
\ No newline at end of file
+    ro.system.ota.json_url=https://raw.githubusercontent.com/Archfx/duo-de/main-16/config/ota.json
diff --git a/base.mk b/base.mk
index 77f5df4..7db6f8c 100644
--- a/base.mk
+++ b/base.mk
@@ -282,10 +282,11 @@ PRODUCT_PACKAGES += \
 	SurfaceDuoSettingsOverlay \
 	SurfaceDuoSettingsIconsOverlay \
 	SurfaceDuoAppHintingOverlay \
-	libms_pen_charger
+	libms_pen_charger \
+    com.surface.touchpenservice
 
 # Privapp-permissions whitelist for postureProcessor
 PRODUCT_COPY_FILES += \
 	vendor/surface/privapp-permissions-duo.xml:system/system_ext/etc/permissions/privapp-permissions-com.thain.duo.xml
-
+    
 $(call inherit-product-if-exists, vendor/surface/prebuilts/bootanimation/bootanimation.mk)
\ No newline at end of file
