+package com.android.launcher3.util;
+
+import android.os.Build;
+
+import com.android.internal.policy.DuoPanelGeometry;
+
+/**
+ * The two Surface Duo panels as Launcher3 needs them: the left and right screen of a landscape (side by side) display,
+ * with the hinge between them. Replaces the 1344 / 2500 / 1394 literals of the Duo-DE modifications.
+ */
+public final class DuoPanels {
+    private DuoPanels() { }
+
+    /**
+     * The {left, right} panel rects {l, t, r, b} of a Duo whose display is spanned (hinge band) or gapless
+     * (no hinge gap) and wider than tall, or null on any other device or posture.
+     */
+    public static int[][] halves(int widthPx, int heightPx) {
+        if (widthPx <= heightPx) return null;
+        DuoPanelGeometry.Spec spec = DuoPanelGeometry.forDevice(Build.DEVICE);
+        int mode = DuoPanelGeometry.mode(spec, widthPx, heightPx);
+        if (mode != DuoPanelGeometry.MODE_SPANNED && mode != DuoPanelGeometry.MODE_GAPLESS) return null;
+        // Rotation 0 and 180 have the same two rects, panel 0 is simply on the other side.
+        int[][] layout = DuoPanelGeometry.layout(spec, widthPx, heightPx, 0);
+        return new int[][] {layout[DuoPanelGeometry.PANEL_0], layout[DuoPanelGeometry.PANEL_1]};
+    }
+
+    public static boolean isSpannedLandscape(int widthPx, int heightPx) {
+        return halves(widthPx, heightPx) != null;
+    }
+
+    /** True when x is on the right screen; a touch on the hinge goes to the nearer screen. */
+    public static boolean isRightHalf(int[][] halves, float x) {
+        return x >= (halves[0][2] + halves[1][0]) / 2f;
+    }
+}
