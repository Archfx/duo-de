From d84dfffb8fe3fb01b8d5b3a388fc615eb2206fd1 Mon Sep 17 00:00:00 2001
From: ethan <ethangoh98@gmail.com>
Date: Thu, 1 Oct 2026 04:37:32 +1100
Subject: [PATCH 2/2] Add rules to prevent classes being thrown out.

project packages/apps/Launcher3/
---
 proguard.flags | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/proguard.flags b/proguard.flags
index ebf177a9d7..fd2a50cb3a 100644
--- a/proguard.flags
+++ b/proguard.flags
@@ -51,4 +51,15 @@
 # Don't warn about those in case this app is linking against an older
 # platform version.  We know about them, and they are safe.
 -dontwarn android.support.**
--dontwarn org.apache.http.**
\ No newline at end of file
+-dontwarn org.apache.http.**
+
+# Keep Launcher3 ResourceBasedOverride classes and their constructors intact
+-keep class * implements com.android.launcher3.util.ResourceBasedOverride {
+    public void <init>(...);
+}
+-keep class com.android.launcher3.taskbar.TaskbarModelCallbacksFactory {
+    public void <init>(...);
+}
+-keep class * extends com.android.launcher3.taskbar.TaskbarViewCallbacksFactory {
+    public void <init>(android.content.Context);
+}
-- 
