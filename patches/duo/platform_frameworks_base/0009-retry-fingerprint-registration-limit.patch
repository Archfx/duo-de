-        } catch (java.util.NoSuchElementException e) {
-            // Service doesn't exist or cannot be opened.
-            Slog.w(TAG, "NoSuchElementException", e);
+            mDaemon = getServiceSafely();
+        } catch (Exception e){
+            Slog.w(TAG, "HIDL fingerprint fetching failed: " + e);
         }
 
