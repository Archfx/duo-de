+package com.android.internal.policy;
+
+/**
+ * Where the two panels and the hinge of a Surface Duo are, in the pixels of the current display.
+ *
+ * One source of truth for code that needs to keep things off the hinge or to place windows on a panel, instead of
+ * literals such as 1344 or 2500. Pure arithmetic on ints, so it also compiles and is tested on the host.
+ *
+ * The device is described in its natural (rotation 0) orientation, which for the Duo is the two panels side by side:
+ * panel 0 on the left, the hinge band, panel 1 on the right. Rectangles are returned as {left, top, right, bottom} in
+ * the coordinates of the display at the given rotation, so panel 0 follows the physical left panel as the device turns
+ * (ROTATION_90 puts it at the bottom, ROTATION_180 on the right, ROTATION_270 at the top).
+ *
+ * @hide
+ */
+public final class DuoPanelGeometry {
+    /** Both panels and the hinge band are visible: the display is 2 * panel + hinge long. */
+    public static final int MODE_SPANNED = 0;
+    /** The hinge gap is disabled: the display is exactly two panels long and the seam has no width. */
+    public static final int MODE_GAPLESS = 1;
+    /** One panel is shown: the display is a single panel. */
+    public static final int MODE_SINGLE = 2;
+    /** The display size matches none of the above (another device, a letterboxed or scaled display). */
+    public static final int MODE_UNKNOWN = 3;
+
+    /** Index of the rect for the first panel in the array returned by {@link #layout}. */
+    public static final int PANEL_0 = 0;
+    /** Index of the rect for the second panel in the array returned by {@link #layout}. */
+    public static final int PANEL_1 = 1;
+    /** Index of the hinge band in the array returned by {@link #layout}. */
+    public static final int HINGE = 2;
+
+    /** Physical panel width, hinge band width and panel height of a device, in natural orientation. */
+    public static final class Spec {
+        public final int panel;
+        public final int hinge;
+        public final int height;
+
+        public Spec(int panel, int hinge, int height) {
+            this.panel = panel;
+            this.hinge = hinge;
+            this.height = height;
+        }
+    }
+
+    public static final Spec DUO = new Spec(1350, 84, 1800);
+    public static final Spec DUO2 = new Spec(1344, 66, 1892);
+
+    private DuoPanelGeometry() {
+    }
+
+    /** The geometry for a {@code Build.DEVICE} value, or null when it is not a Surface Duo. */
+    public static Spec forDevice(String device) {
+        if ("duo2".equals(device)) return DUO2;
+        if ("duo".equals(device)) return DUO;
+        return null;
+    }
+
+    /** How a display of the given size relates to the device, whatever its rotation. */
+    public static int mode(Spec spec, int displayWidth, int displayHeight) {
+        if (spec == null) return MODE_UNKNOWN;
+        int longSide = Math.max(displayWidth, displayHeight);
+        int shortSide = Math.min(displayWidth, displayHeight);
+        // One panel is panel x height, so its short side is the panel width, not the height.
+        if (shortSide == spec.panel && longSide == spec.height) return MODE_SINGLE;
+        if (shortSide != spec.height) return MODE_UNKNOWN;
+        if (longSide == 2 * spec.panel + spec.hinge) return MODE_SPANNED;
+        if (longSide == 2 * spec.panel) return MODE_GAPLESS;
+        return MODE_UNKNOWN;
+    }
+
+    /**
+     * The rects {panel 0, panel 1, hinge} for a display of the given size and rotation (Surface.ROTATION_*).
+     * Spanned: both panels and the hinge band. Gapless: both panels and a zero-width hinge rect on the seam.
+     * Single: panel 0 is the whole display, panel 1 and the hinge are empty (all zeros). Unknown: null.
+     */
+    public static int[][] layout(Spec spec, int displayWidth, int displayHeight, int rotation) {
+        int mode = mode(spec, displayWidth, displayHeight);
+        if (mode == MODE_UNKNOWN) return null;
+        if (mode == MODE_SINGLE) {
+            return new int[][] {
+                {0, 0, displayWidth, displayHeight}, {0, 0, 0, 0}, {0, 0, 0, 0}};
+        }
+        int hinge = mode == MODE_SPANNED ? spec.hinge : 0;
+        int w = 2 * spec.panel + hinge;   // natural width
+        int h = spec.height;
+        int[][] natural = {
+            {0, 0, spec.panel, h},
+            {spec.panel + hinge, 0, w, h},
+            {spec.panel, 0, spec.panel + hinge, h}};
+        int[][] out = new int[3][];
+        for (int i = 0; i < 3; i++) out[i] = rotate(natural[i], w, h, rotation);
+        return out;
+    }
+
+    /** True when the rectangle {l,t,r,b} overlaps the hinge band (a zero-width hinge overlaps nothing). */
+    public static boolean intersectsHinge(int[][] layout, int left, int top, int right, int bottom) {
+        if (layout == null) return false;
+        int[] hinge = layout[HINGE];
+        return hinge[0] < hinge[2] && hinge[1] < hinge[3]
+                && left < hinge[2] && right > hinge[0] && top < hinge[3] && bottom > hinge[1];
+    }
+
+    /** Index of the panel containing the point, or -1 when it is on the hinge or outside both. */
+    public static int panelAt(int[][] layout, int x, int y) {
+        if (layout == null) return -1;
+        for (int i = PANEL_0; i <= PANEL_1; i++) {
+            int[] r = layout[i];
+            if (x >= r[0] && x < r[2] && y >= r[1] && y < r[3]) return i;
+        }
+        return -1;
+    }
+
+    /** Maps a rect from the natural (rotation 0, width x height) display to the display at {@code rotation}. */
+    static int[] rotate(int[] r, int w, int h, int rotation) {
+        switch (rotation & 3) {
+            case 1:  return new int[] {r[1], w - r[2], r[3], w - r[0]};
+            case 2:  return new int[] {w - r[2], h - r[3], w - r[0], h - r[1]};
+            case 3:  return new int[] {h - r[3], r[0], h - r[1], r[2]};
+            default: return r.clone();
+        }
+    }
+}
diff --git a/core/tests/DuoPanelGeometryTests/Android.bp b/core/tests/DuoPanelGeometryTests/Android.bp
