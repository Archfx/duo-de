diff --git a/core/tests/DuoPanelGeometryTests/src/com/android/internal/policy/DuoPanelGeometryTest.java b/core/tests/DuoPanelGeometryTests/src/com/android/internal/policy/DuoPanelGeometryTest.java
new file mode 100644
index 000000000000..8e0312e5ab12
--- /dev/null
+++ b/core/tests/DuoPanelGeometryTests/src/com/android/internal/policy/DuoPanelGeometryTest.java
@@ -0,0 +1,183 @@
+/*
