+
+package com.android.internal.policy;
+
+import static com.android.internal.policy.DuoPanelGeometry.HINGE;
+import static com.android.internal.policy.DuoPanelGeometry.MODE_GAPLESS;
+import static com.android.internal.policy.DuoPanelGeometry.MODE_SINGLE;
+import static com.android.internal.policy.DuoPanelGeometry.MODE_SPANNED;
+import static com.android.internal.policy.DuoPanelGeometry.MODE_UNKNOWN;
+import static com.android.internal.policy.DuoPanelGeometry.PANEL_0;
+import static com.android.internal.policy.DuoPanelGeometry.PANEL_1;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+/** Host tests for {@link DuoPanelGeometry}. */
+@RunWith(JUnit4.class)
+public class DuoPanelGeometryTest {
+    private static final DuoPanelGeometry.Spec D2 = DuoPanelGeometry.DUO2;   // 1344 + 66 hinge, 1892 high
+    private static final DuoPanelGeometry.Spec D1 = DuoPanelGeometry.DUO;    // 1350 + 84 hinge, 1800 high
+
+    @Test
+    public void forDevice() {
+        assertEquals(D2, DuoPanelGeometry.forDevice("duo2"));
+        assertEquals(D1, DuoPanelGeometry.forDevice("duo"));
+        assertNull(DuoPanelGeometry.forDevice("panther"));
+        assertNull(DuoPanelGeometry.forDevice(null));
+    }
+
+    @Test
+    public void modes() {
+        assertEquals(MODE_SPANNED, DuoPanelGeometry.mode(D2, 2754, 1892));
+        assertEquals(MODE_SPANNED, DuoPanelGeometry.mode(D2, 1892, 2754));
+        assertEquals(MODE_GAPLESS, DuoPanelGeometry.mode(D2, 2688, 1892));
+        assertEquals(MODE_GAPLESS, DuoPanelGeometry.mode(D2, 1892, 2688));
+        assertEquals(MODE_SINGLE, DuoPanelGeometry.mode(D2, 1344, 1892));
+        assertEquals(MODE_SINGLE, DuoPanelGeometry.mode(D2, 1892, 1344));
+        assertEquals(MODE_SPANNED, DuoPanelGeometry.mode(D1, 2784, 1800));
+        assertEquals(MODE_GAPLESS, DuoPanelGeometry.mode(D1, 2700, 1800));
+        assertEquals(MODE_SINGLE, DuoPanelGeometry.mode(D1, 1350, 1800));
+    }
+
+    @Test
+    public void unknownSizesAndDevices() {
+        assertEquals(MODE_UNKNOWN, DuoPanelGeometry.mode(null, 2754, 1892));
+        assertEquals(MODE_UNKNOWN, DuoPanelGeometry.mode(D2, 2754, 1800));   // wrong height
+        assertEquals(MODE_UNKNOWN, DuoPanelGeometry.mode(D2, 2600, 1892));   // letterboxed
+        assertEquals(MODE_UNKNOWN, DuoPanelGeometry.mode(D2, 1080, 1920));
+        assertNull(DuoPanelGeometry.layout(D2, 2600, 1892, 0));
+        assertNull(DuoPanelGeometry.layout(null, 2754, 1892, 0));
+    }
+
+    @Test
+    public void spannedRotation0() {
+        int[][] l = DuoPanelGeometry.layout(D2, 2754, 1892, 0);
+        assertArrayEquals(new int[] {0, 0, 1344, 1892}, l[PANEL_0]);
+        assertArrayEquals(new int[] {1410, 0, 2754, 1892}, l[PANEL_1]);
+        assertArrayEquals(new int[] {1344, 0, 1410, 1892}, l[HINGE]);
+    }
+
+    @Test
+    public void spannedAllRotations() {
+        // 1: panel 0 at the bottom, 2: on the right, 3: at the top
+        int[][] r1 = DuoPanelGeometry.layout(D2, 1892, 2754, 1);
+        assertArrayEquals(new int[] {0, 1410, 1892, 2754}, r1[PANEL_0]);
+        assertArrayEquals(new int[] {0, 0, 1892, 1344}, r1[PANEL_1]);
+        assertArrayEquals(new int[] {0, 1344, 1892, 1410}, r1[HINGE]);
+        int[][] r2 = DuoPanelGeometry.layout(D2, 2754, 1892, 2);
+        assertArrayEquals(new int[] {1410, 0, 2754, 1892}, r2[PANEL_0]);
+        assertArrayEquals(new int[] {0, 0, 1344, 1892}, r2[PANEL_1]);
+        assertArrayEquals(new int[] {1344, 0, 1410, 1892}, r2[HINGE]);
+        int[][] r3 = DuoPanelGeometry.layout(D2, 1892, 2754, 3);
+        assertArrayEquals(new int[] {0, 0, 1892, 1344}, r3[PANEL_0]);
+        assertArrayEquals(new int[] {0, 1410, 1892, 2754}, r3[PANEL_1]);
+        assertArrayEquals(new int[] {0, 1344, 1892, 1410}, r3[HINGE]);
+    }
+
+    @Test
+    public void panelsAndHingeTileTheDisplay() {
+        for (DuoPanelGeometry.Spec s : new DuoPanelGeometry.Spec[] {D1, D2}) {
+            for (int rot = 0; rot < 4; rot++) {
+                int w = 2 * s.panel + s.hinge;
+                int h = s.height;
+                boolean portrait = (rot & 1) == 1;
+                int dw = portrait ? h : w;
+                int dh = portrait ? w : h;
+                int[][] l = DuoPanelGeometry.layout(s, dw, dh, rot);
+                assertNotNull(l);
+                long area = 0;
+                for (int[] r : l) area += (long) (r[2] - r[0]) * (r[3] - r[1]);
+                assertEquals("rot " + rot, (long) dw * dh, area);
+                for (int[] r : l) {
+                    assertTrue(r[0] >= 0 && r[1] >= 0 && r[2] <= dw && r[3] <= dh);
+                }
+            }
+        }
+    }
+
+    @Test
+    public void gaplessHasZeroWidthSeam() {
+        int[][] l = DuoPanelGeometry.layout(D2, 2688, 1892, 0);
+        assertArrayEquals(new int[] {0, 0, 1344, 1892}, l[PANEL_0]);
+        assertArrayEquals(new int[] {1344, 0, 2688, 1892}, l[PANEL_1]);
+        assertArrayEquals(new int[] {1344, 0, 1344, 1892}, l[HINGE]);
+        assertFalse(DuoPanelGeometry.intersectsHinge(l, 1300, 0, 1400, 100));
+        int[][] r1 = DuoPanelGeometry.layout(D2, 1892, 2688, 1);
+        assertArrayEquals(new int[] {0, 1344, 1892, 2688}, r1[PANEL_0]);
+        assertArrayEquals(new int[] {0, 1344, 1892, 1344}, r1[HINGE]);
+    }
+
+    @Test
+    public void singlePanelIsTheWholeDisplay() {
+        for (int rot = 0; rot < 4; rot++) {
+            boolean portrait = (rot & 1) == 1;
+            int dw = portrait ? 1892 : 1344;
+            int dh = portrait ? 1344 : 1892;
+            int[][] l = DuoPanelGeometry.layout(D2, dw, dh, rot);
+            assertArrayEquals(new int[] {0, 0, dw, dh}, l[PANEL_0]);
+            assertArrayEquals(new int[] {0, 0, 0, 0}, l[PANEL_1]);
+            assertArrayEquals(new int[] {0, 0, 0, 0}, l[HINGE]);
+            assertFalse(DuoPanelGeometry.intersectsHinge(l, 0, 0, dw, dh));
+        }
+    }
+
+    @Test
+    public void intersectsHinge() {
+        int[][] l = DuoPanelGeometry.layout(D2, 2754, 1892, 0);
+        assertTrue(DuoPanelGeometry.intersectsHinge(l, 1300, 10, 1380, 60));    // crosses the left edge
+        assertTrue(DuoPanelGeometry.intersectsHinge(l, 1360, 1800, 1400, 1810));  // inside
+        assertTrue(DuoPanelGeometry.intersectsHinge(l, 1394, 0, 2754, 1892));   // the old right launch rect, 16 px in
+        assertFalse(DuoPanelGeometry.intersectsHinge(l, 0, 0, 1344, 1892));     // touching is not overlapping
+        assertFalse(DuoPanelGeometry.intersectsHinge(l, 1410, 0, 2754, 1892));
+        assertTrue(DuoPanelGeometry.intersectsHinge(l, 0, 0, 2754, 1892));      // a spanned window does
+        assertFalse(DuoPanelGeometry.intersectsHinge(null, 0, 0, 10, 10));
+    }
+
+    @Test
+    public void panelAt() {
+        int[][] l = DuoPanelGeometry.layout(D2, 2754, 1892, 0);
+        assertEquals(PANEL_0, DuoPanelGeometry.panelAt(l, 0, 0));
+        assertEquals(PANEL_0, DuoPanelGeometry.panelAt(l, 1343, 1891));
+        assertEquals(-1, DuoPanelGeometry.panelAt(l, 1344, 100));
+        assertEquals(-1, DuoPanelGeometry.panelAt(l, 1409, 100));
+        assertEquals(PANEL_1, DuoPanelGeometry.panelAt(l, 1410, 100));
+        assertEquals(-1, DuoPanelGeometry.panelAt(l, 2754, 100));
+        assertEquals(-1, DuoPanelGeometry.panelAt(null, 0, 0));
+        int[][] r2 = DuoPanelGeometry.layout(D2, 2754, 1892, 2);
+        assertEquals(PANEL_1, DuoPanelGeometry.panelAt(r2, 0, 0));      // panel 0 follows the physical left panel
+        assertEquals(PANEL_0, DuoPanelGeometry.panelAt(r2, 2000, 0));
+    }
+
+    @Test
+    public void rotationIsReversible() {
+        int[] r = {10, 20, 300, 400};
+        int w = 2754, h = 1892;
+        // rotate 1 then undo by rotating the result with 3 on the swapped display
+        int[] a = DuoPanelGeometry.rotate(r, w, h, 1);
+        int[] back = DuoPanelGeometry.rotate(a, h, w, 3);
+        assertArrayEquals(r, back);
+    }
+}
