From d00601aaaef3a378f29390436a8e6930abfa902f Mon Sep 17 00:00:00 2001
From: builder <builder@aosp-vm>
Date: Fri, 9 Oct 2026 18:42:50 +0000
Subject: [PATCH] Remove the LG vibrator HIDL interface

vendor.lge.hardware.vibrator@1.0 depends on android.hardware.vibrator@1.0_interface, which android-16.0.0_r4 removed
(HIDL clean-up). Nothing else uses it once device/phh/treble drops vibrator-lge.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 vendor/lge/hardware/vibrator/1.0/Android.bp      | 15 ---------------
 vendor/lge/hardware/vibrator/1.0/IVibratorEx.hal |  7 -------
 2 files changed, 22 deletions(-)
 delete mode 100644 vendor/lge/hardware/vibrator/1.0/Android.bp
 delete mode 100644 vendor/lge/hardware/vibrator/1.0/IVibratorEx.hal

diff --git a/vendor/lge/hardware/vibrator/1.0/Android.bp b/vendor/lge/hardware/vibrator/1.0/Android.bp
deleted file mode 100644
index fa69894..0000000
--- a/vendor/lge/hardware/vibrator/1.0/Android.bp
+++ /dev/null
@@ -1,15 +0,0 @@
-// This file is autogenerated by hidl-gen -Landroidbp.
-
-hidl_interface {
-    name: "vendor.lge.hardware.vibrator@1.0",
-    root: "vendor",
-    srcs: [
-        "IVibratorEx.hal",
-    ],
-    interfaces: [
-        "android.hardware.vibrator@1.0",
-        "android.hidl.base@1.0",
-    ],
-    gen_java: true,
-}
-
diff --git a/vendor/lge/hardware/vibrator/1.0/IVibratorEx.hal b/vendor/lge/hardware/vibrator/1.0/IVibratorEx.hal
deleted file mode 100644
index 6a33b87..0000000
--- a/vendor/lge/hardware/vibrator/1.0/IVibratorEx.hal
+++ /dev/null
@@ -1,7 +0,0 @@
-package vendor.lge.hardware.vibrator@1.0;
-
-import android.hardware.vibrator@1.0::IVibrator;
-
-interface IVibratorEx extends IVibrator {
-	playEffectWithStrength(vec<int8_t> effectData, int32_t effectIndex, int32_t strength) generates (int32_t status);
-};
-- 
2.43.0

